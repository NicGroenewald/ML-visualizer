# ── Obsidian workspace config (personal, not project docs) ───────────────────
ML-visualizer-documentation/.obsidian/

# ── Session notes (personal dev diary, not for public repo) ──────────────────
ML-visualizer-documentation/sessions/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── ML artefacts (serialised models / arrays — can be large or leak train data)
*.pkl
*.pickle
*.joblib
*.h5
*.hdf5
*.npy
*.npz
models/
checkpoints/

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Anaconda local-prefix envs ────────────────────────────────────────────────
# Only relevant if you run: conda create --prefix ./env
# (NN-crew is managed globally, so this is just a safety net)
conda-meta/
envs/
pkgs/

# ── Graphify (knowledge graph, generated — rebuild with /graphify .) ──────────
graphify-out/
.graphify_manifest.json

# ── Temp / scratch ────────────────────────────────────────────────────────────
tmp/
temp/
scratch/
*.tmp
demo_run.py
tests/integration_e2e.py

