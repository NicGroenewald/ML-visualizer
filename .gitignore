*.key
*.p12
*.pfx

# ── Node / frontend build ─────────────────────────────────────────────────────
mlviz/frontend/node_modules/
mlviz/frontend/.vite/
mlviz/frontend/.env.local
mlviz/frontend/.env.*.local

